#!/bin/bash
# Run a git command, then sweep aside lock/temp files git could not delete itself.
#
# The Cowork mount of this folder disallows unlink, so git leaves .git/index.lock
# and tmp_obj_* behind and the NEXT git command fails with "File exists".
# Moving them into _to_delete/ is permitted and keeps the repo usable.
# Not needed when you run git from your own Terminal — only inside Cowork.
#
#   ./gitsafe add -A
#   ./gitsafe commit -m "ep002"
#   ./gitsafe push
D="$(cd "$(dirname "$0")" && pwd)"
sweep() {
  mkdir -p "$D/_to_delete"
  find "$D/.git" \( -name '*.lock' -o -name 'tmp_obj_*' \) -print0 2>/dev/null |
  while IFS= read -r -d '' f; do
    mv -n "$f" "$D/_to_delete/$(date +%s)_$$_$(basename "$f")" 2>/dev/null || true
  done
}
sweep
# Identity for commits made from inside Cowork. Set here rather than in the
# repo config so commits JJ makes from his own Terminal keep his own name.
git -C "$D" -c user.name="Claude" -c user.email="noreply@anthropic.com" "$@"
status=$?
sweep
exit $status
